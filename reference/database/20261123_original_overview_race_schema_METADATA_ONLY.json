          "definition": "CHECK (finish_type = ANY (ARRAY['flat_finish'::text, 'uphill_finish'::text, 'summit_finish'::text, 'time_trial_finish'::text, 'team_time_trial_finish'::text, 'prologue_finish'::text, 'cobbled_finish'::text]))"
