        },
        {
          "kind": "c",
          "name": "race_stages_stage_number_chk",
          "definition": "CHECK (stage_number > 0)"
        },
        {
          "kind": "c",
          "name": "race_stages_start_time_region_code_chk",
          "definition": "CHECK (start_time_region_code IS NULL OR (start_time_region_code = ANY (ARRAY['apac'::text, 'emea'::text, 'americas'::text])))"
        },
        {
          "kind": "c",
          "name": "race_stages_terrain_percent_ranges_chk",
          "definition": "CHECK (flat_pct >= 0::numeric AND flat_pct <= 100::numeric AND hilly_pct >= 0::numeric AND hilly_pct <= 100::numeric AND mountain_pct >= 0::numeric AND mountain_pct <= 100::numeric AND cobbled_pct >= 0::numeric AND cobbled_pct <= 100::numeric)"
        },
        {
          "kind": "c",
          "name": "race_stages_terrain_percent_sum_chk",
          "definition": "CHECK ((flat_pct + hilly_pct + mountain_pct + cobbled_pct) >= 99.00 AND (flat_pct + hilly_pct + mountain_pct + cobbled_pct) <= 101.00)"
        },
