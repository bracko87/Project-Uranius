        {
          "kind": "f",
          "name": "races_country_code_fkey",
          "definition": "FOREIGN KEY (country_code) REFERENCES countries(code)"
        },
        {
          "kind": "c",
          "name": "races_date_order_chk",
          "definition": "CHECK (end_date >= start_date)"
        },
        {
          "kind": "p",
          "name": "races_pkey",
          "definition": "PRIMARY KEY (id)"
        },
        {
          "kind": "c",
          "name": "races_planned_start_hour_number_chk",
          "definition": "CHECK (planned_start_hour_number IS NULL OR planned_start_hour_number >= 0 AND planned_start_hour_number <= 23)"
        },
        {
          "kind": "c",
          "name": "races_planned_start_minute_chk",
          "definition": "CHECK (planned_start_minute = ANY (ARRAY[0, 15, 30, 45]))"
        },
        {
          "kind": "c",
          "name": "races_race_type_chk",
          "definition": "CHECK (race_type = ANY (ARRAY['one_day'::text, 'stage_race'::text]))"
        },
        {
          "kind": "c",
          "name": "races_stage_count_chk",
          "definition": "CHECK (stage_count > 0)"
        },
        {
          "kind": "c",
          "name": "races_start_time_region_code_chk",
          "definition": "CHECK (start_time_region_code IS NULL OR (start_time_region_code = ANY (ARRAY['apac'::text, 'emea'::text, 'americas'::text])))"
        },
        {
          "kind": "c",
          "name": "races_status_chk",
          "definition": "CHECK (status = ANY (ARRAY['draft'::text, 'scheduled'::text, 'active'::text, 'completed'::text, 'cancelled'::text, 'archived'::text]))"
        }
      ]
    },
